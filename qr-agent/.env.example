# ───────── QR BUSINESS AI AGENT — copiez ce fichier en `.env` (jamais commité) ─────────
NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://agent.votre-domaine.com     # URL publique du serveur (liens des démos et de désinscription)
DATA_DIR=/data                                        # base embarquée (PGlite) + sauvegardes ; ou DATABASE_URL=postgres://… pour un PostgreSQL hébergé

# Accès propriétaire (production : hash obligatoire → `node server/scripts-hash.mjs "votre mot de passe"`)
ADMIN_EMAIL=vous@exemple.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=                                       # 32+ caractères aléatoires : `openssl rand -base64 48`
INBOUND_WEBHOOK_SECRET=                               # si votre fournisseur transmet les réponses par webhook

# Expéditeur (obligatoire avant tout envoi réel)
SENDER_NAME=Mourad
SENDER_COMPANY=NM Studio
SENDER_POSTAL_ADDRESS="Votre adresse postale complète"
EMAIL_FROM="Mourad <hello@votre-domaine.com>"
REPLY_TO=hello@votre-domaine.com
USER_AGENT_CONTACT=mailto:hello@votre-domaine.com    # affiché aux sites analysés (poli, identifiable)

# IA (facultatif : sans clé, modèles d'emails fixes)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_CALL_LIMIT=200

# Email : dryrun (défaut, rien ne part) | resend | smtp   — l'envoi réel exige AUSSI EMAIL_LIVE=true
EMAIL_PROVIDER=dryrun
EMAIL_LIVE=false
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Relever les réponses (alternative au webhook)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Sources de prospects
OVERPASS_URL=https://overpass-api.de/api/interpreter  # OpenStreetMap (gratuit) — votre propre instance pour de gros volumes
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false                           # lisez d'abord les conditions de Google (stockage / leads)
